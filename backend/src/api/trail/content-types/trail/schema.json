{
  "kind": "collectionType",
  "collectionName": "trails",
  "info": {
    "singularName": "trail",
    "pluralName": "trails",
    "displayName": "Trail"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "slug": {
      "type": "string"
    },
    "body": {
      "type": "blocks"
    },
    "summary": {
      "type": "string"
    },
    "distance_km": {
      "type": "integer"
    },
    "elevation_gain_m": {
      "type": "integer"
    },
    "duration_hours": {
      "type": "decimal"
    },
    "permit_required": {
      "type": "boolean"
    },
    "photos": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "difficulty": {
      "type": "enumeration",
      "enum": [
        "Easy",
        "Moderate",
        "Hard",
        " Expert"
      ]
    },
    "best_season": {
      "type": "enumeration",
      "enum": [
        "Spring",
        "Summer",
        "Autumn",
        " Winter"
      ]
    },
    "starting_point": {
      "type": "string"
    },
    "ending_point": {
      "type": "string"
    },
    "district_start": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::district.district"
    },
    "district_end": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::district.district"
    },
    "tehsil_start": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::tehsil.tehsil"
    },
    "tehsil_end": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::tehsil.tehsil"
    },
    "max_altitude": {
      "type": "decimal"
    },
    "trail_type": {
      "type": "enumeration",
      "enum": [
        "loop",
        "in and out",
        "point to point"
      ]
    },
    "water_sources": {
      "type": "boolean"
    },
    "camping_available": {
      "type": "boolean"
    },
    "gps_coordinates_start": {
      "type": "string"
    },
    "gps_coordinates_end": {
      "type": "string"
    },
    "seasons": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::season.season",
      "mappedBy": "trails"
    }
  }
}
